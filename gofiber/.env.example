# Application Configuration
APP_NAME=GoFiber Template
APP_PORT=3000
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=gofiber_template
DB_SSL_MODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# S3-compatible Storage (Cloudflare R2, iDrive e2, AWS S3, etc.)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_PUBLIC_URL=https://pub-xxxxx.r2.dev
S3_PRIVATE_BUCKET=true  # Set to true for private buckets (uses presigned URLs via /api/v1/storage/*)

# Service Fee (ค่าบริการต่อที่นั่ง — รวมอยู่ในราคาที่นั่ง, VAT คิดจากค่านี้)
SERVICE_FEE_PER_PAX=500  # บาท/คน (รวม VAT)

# SlipOK — ตรวจสอบสลิปโอนเงินอัตโนมัติ (https://slipok.com)
SLIPOK_BRANCH_ID=       # Branch ID จาก SlipOK
SLIPOK_API_KEY=         # API Key จาก SlipOK

# SMTP Email — ส่ง email แจ้งสถานะการจอง
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                # email address
SMTP_PASS=                # app password
SMTP_FROM=                # sender email
SMTP_FROM_NAME=TIAOJIN    # sender name