# MongoDB Migration Configuration
# Copy this to .env in the migration folder and update with your actual values

# MongoDB URI from old system (get from old system's .env or MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# PostgreSQL Configuration (same as main app)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=tiaojin_db
DB_SSL_MODE=disable
